# Local development only. Never commit the real key.
BIGDATACLOUD_API_KEY=replace-with-your-server-side-key
BIGDATACLOUD_LOCALITY_LANGUAGE=en
BIGDATACLOUD_TIMEOUT_SECONDS=10

# Require PostgreSQL/PostGIS for local service runs. The Compose stack sets
# this URL to its named PostGIS service automatically.
GEO_DATABASE_URL=postgresql://myota:myota-dev-only@127.0.0.1:5432/myota_geo
MYOTA_REQUIRE_DURABILITY=1
